# NOVO ciclo privado. Não reaproveitar a .env do publicador antigo ou do Radar.
# Copiar para .env.autonomous e chmod 600. Nunca commitar valores reais.
AUTONOMOUS_ENABLED=false
AGENTE_REQUER_APROVACAO=true
SITE_URL=https://tomezap.com.br
AGENT_PUBLIC_URL=https://bot.tomezap.com.br
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Marcar true SOMENTE depois de confirmar o projeto sem cobrança no provedor.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MAX_CALLS_PER_DAY=40

# RSS é prioritário. A busca complementar é opcional.
RSS_SOURCES_FILE=/app/config/sources.json
TAVILY_API_KEY=
TAVILY_FREE_TIER_CONFIRMED=false
TAVILY_MAX_CALLS_PER_DAY=20
TAVILY_MAX_CALLS_PER_MONTH=600
MAX_PENDING_DRAFTS=5

TNN_DRAFTS_URL=https://dfbeerxqqfqkwlljrjko.supabase.co/functions/v1/tnn-drafts
# Token de escrita só em rascunhos, NUNCA service_role ou token da ingestão.
TNN_DRAFT_SERVICE_TOKEN=
# Mesmo WA_PIPELINE_TOKEN configurado no bridge, diferente de WA_BRIDGE_TOKEN.
WA_PIPELINE_TOKEN=
# Gerar outro segredo aleatório de 64 caracteres hexadecimais.
REDACTION_REDIS_PASSWORD=
# Entrada de pautas pelo grupo; não depende de AUTONOMOUS_ENABLED.
MANUAL_ENABLED=false
TNN_EDITORIAL_URL=https://dfbeerxqqfqkwlljrjko.supabase.co/functions/v1/tnn-editorial
# Token de chamada editorial exclusivo. Não é service_role nem a assinatura.
TNN_EDITORIAL_TOKEN=

# Sem valores secretos no arquivo de configuração do monitor. Montar como somente leitura.
TNN_MONITORS_FILE=
# Horário de Fortaleza, 0–23. Envia só ao grupo já confirmado, uma vez por dia.
TNN_DAILY_SUMMARY_ENABLED=false
TNN_DAILY_SUMMARY_HOUR=20
