FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-autonomous.txt ./
RUN pip install --no-cache-dir -r requirements-autonomous.txt && useradd --uid 10001 --create-home redacao
COPY --chown=redacao:redacao tnn ./tnn
USER redacao
CMD ["python", "-m", "tnn.autonomous.worker"]
