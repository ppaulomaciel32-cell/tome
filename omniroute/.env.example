# Segredos do OmniRoute da VPS (docker-compose.omniroute.yml). Copie para omniroute/.env (chmod 600).
# Gere cada valor no servidor; não reaproveite chaves de outros serviços.
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -hex 32
API_KEY_SECRET=
# openssl rand -hex 32 — sem ela o banco não abre; guarde junto do backup.
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1
# Senha do primeiro login no painel (troque em Configurações → Segurança).
INITIAL_PASSWORD=
