# Exclusivo do painel. Nunca copiar a .env do agente ou do Radar para cá.
NODE_ENV=production
HOST=0.0.0.0
PORT=3080
SITE_URL=https://tomezap.com.br
SUPABASE_URL=https://dfbeerxqqfqkwlljrjko.supabase.co
# Chave pública publishable ou anon, nunca service_role.
SUPABASE_PUBLISHABLE_KEY=
PANEL_OWNER_EMAIL=p.paulomaciel.32@gmail.com
# Contas existentes e com e-mail confirmado, separadas por vírgula.
PANEL_EDITOR_EMAILS=
# Somente atrás do nginx com X-Real-IP sobrescrito e porta privada.
PANEL_TRUST_PROXY=true
# Obrigatório na instalação persistente; Compose já define e monta este caminho.
# Uma instância apenas. A chave é criada no volume, nunca vai ao navegador.
PANEL_SESSION_DIR=/data/panel-sessions

# O módulo QR é um serviço privado e opcional no mesmo projeto Docker.
AGENT_PUBLIC_URL=https://bot.tomezap.com.br
WA_BRIDGE_URL=http://whatsapp:3090
WA_BRIDGE_TOKEN=

# Token SOMENTE DE LEITURA, diferente do token usado pelo trabalhador Python.
