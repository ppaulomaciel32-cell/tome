# Nunca usar números pessoais como o chip do robô. Ativar somente após configurar.
WA_ENABLED=false
WA_DEDICATED_NUMBER=
# Dono e namorada, DDI+DDD+número, separados por vírgula. Não incluir o chip.
WA_ALLOWED_SENDERS=
# Gere dois valores DIFERENTES com: openssl rand -hex 32
# WA_BRIDGE_TOKEN também precisa estar no .env de panel-api.
WA_BRIDGE_TOKEN=
WA_SESSION_KEY=
WA_SESSION_DIR=/data/session
# Obrigatório. Não há auto-publicação nesta implementação.
AGENTE_REQUER_APROVACAO=true
