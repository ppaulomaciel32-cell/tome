# Preferir chip dedicado. Número pessoal só por decisão informada do dono.
# A tela exige ciência do risco de bloqueio da conexão não oficial.
WA_ENABLED=false
WA_DEDICATED_NUMBER=
# Dono e namorada, DDI+DDD+número, separados por vírgula. Não incluir o chip.
WA_ALLOWED_SENDERS=
# Gere dois valores DIFERENTES com: openssl rand -hex 32
# WA_BRIDGE_TOKEN também precisa estar no .env de panel-api.
WA_BRIDGE_TOKEN=
# Exclusivo do ciclo privado: não abre QR nem altera o grupo. Gerar outro token.
WA_PIPELINE_TOKEN=
WA_SESSION_KEY=
WA_SESSION_DIR=/data/session
# Obrigatório. Não há auto-publicação nesta implementação.
AGENTE_REQUER_APROVACAO=true
# Permite comandos do próprio número conectado, SOMENTE no grupo confirmado.
# Não declarar que um chip pessoal é dedicado. O risco de bloqueio permanece.
WA_ACCEPT_OWN_COMMANDS=false
# Ativar após instalar migration/funções, fontes e trabalhador manual.
WA_MANUAL_ENABLED=false
# Segredo de assinatura só na PONTE e na EDGE editorial. Não vai ao Python.
TNN_EDITORIAL_SIGNING_KEY=
